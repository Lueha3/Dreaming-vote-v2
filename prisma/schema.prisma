generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler 6543
  directUrl = env("DIRECT_URL") // direct 5432
}

// 구글 로그인 유저 — Supabase auth.users와 supabaseId로 연결
model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  nickname   String?
  avatarUrl  String?
  // RBAC 전역 등급: member | staff | admin | superadmin
  // (동아리장은 저장하지 않고 Club.ownerUserId로 파생, superadmin은 SUPERADMIN_EMAILS로만 부여)
  role       String   @default("member")
  createdAt  DateTime @default(now())
  reports    Report[]

  // 2차 가입승인 — 구글 로그인(1차) 후 신청서 제출, 관리자 승인 후 공동체 활동 가능
  membershipStatus    String    @default("none") // none | pending | approved | rejected
  realName            String?
  age                 Int?
  // 승인 시점에 고정되는 나이 스냅샷 — 닉네임 집단/나이 검증의 불변 기준.
  // age는 pending 중 재제출로 바뀔 수 있으나, approvedAge는 관리자가 승인한 나이로 굳는다.
  approvedAge         Int?
  gender              String? // 남 | 여
  dreamGroup          String? // 소속 꿈터 이름
  phone               String? // 관리자 화면에서만 노출 — 공개 API 포함 금지
  membershipAppliedAt DateTime?
  membershipDecidedAt DateTime?
  membershipNote      String? // 거절 사유 (신청자에게 표시)
  // 승인 후 최초 진입 시 성격유형 고르기(/start) 1회 안내를 마친 시각.
  // null인 승인 멤버가 홈(/)에 오면 /start?welcome=1로 보낸다. 기록은 /start 실제 방문 시
  // 클라이언트가 POST /api/my/start-seen으로 남긴다(홈 RSC 렌더에서 쓰면 프리페치가 소모해버림).
  startPromptSeenAt   DateTime?
  // 탈퇴 처리 일시 — null이면 활성. 탈퇴는 되돌릴 수 없다(재로그인은 새 행을 만든다).
  // DB에 Prisma로 표현 불가한 CHECK 제약이 걸려 있다(마이그레이션 fix_withdrawal_resurrection):
  //   CHECK ( ("supabaseId" LIKE 'withdrawn:%') = ("deletedAt" IS NOT NULL) )
  // 즉 deletedAt과 supabaseId 툼스톤은 반드시 함께 세팅해야 한다 — lib/withdrawal.ts 경유 필수.
  // (직접 update로 deletedAt만 찍으면 23514로 실패한다.)
  deletedAt           DateTime?
  // 생일 축하 카드 발송용 — 연도는 받지 않는다(개인정보 최소화, 나이는 age로 이미 별도 수집).
  birthMonth          Int?
  birthDay            Int?

  ownedClubs          Club[]               @relation("OwnedClubs")
  clubApplications    ClubApplication[]
  clubRecommendations ClubRecommendation[]
  prayers             Prayer[]
  prayerIntercessions PrayerIntercession[]
  prayerComments      PrayerComment[]
  prayerCommentLikes  PrayerCommentLike[]
  announcements       Announcement[]       @relation("AuthoredAnnouncements")
  meetingReviews      ClubMeetingReview[]
  meetingImages       ClubMeetingImage[]   @relation("MeetingImageUploader")
  meetingRsvps        ClubMeetingRsvp[]
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  contentReports      ContentReport[]      @relation("ReportReporter")
  resolvedReports     ContentReport[]      @relation("ReportResolver")
  pushSubscriptions   PushSubscription[]
  icebreakerPrompts   IcebreakerPrompt[]
  supportTickets      SupportTicket[]
  supportReplies      SupportReply[]       @relation("SupportStaff")

  @@index([membershipStatus, membershipAppliedAt])
}

// 휴대폰 푸시 알림(Web Push) 구독 — 유저 1명이 여러 기기(폰·PC)를 등록할 수 있다.
// endpoint가 기기+브라우저별 고유 식별자. 발송 실패(410 Gone 등) 시 lib/push.ts가 정리한다.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // 암호화 공개키
  auth      String // 인증 시크릿
  userAgent String? // 구독 등록 시점의 UA — 관리자 디버깅용
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 사용자 신고 — 광장 글/댓글/동아리의 부적절 콘텐츠를 운영진이 검토·처리하는 큐.
// (성향 카드 Report 모델과 구분하기 위해 ContentReport로 명명)
model ContentReport {
  id           String    @id @default(cuid())
  reporterId   String?
  targetType   String // prayer | comment | club
  targetId     String
  reason       String // 신고 사유(자유 텍스트)
  status       String    @default("open") // open | resolved | dismissed
  note         String? // 처리 메모(운영진)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter   User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // 부분 유니크 인덱스(content_report_open_dedup_index 마이그레이션)로 본인 동일 대상 open 신고 1건 강제.
  // Prisma 스키마로는 부분 유니크를 표현할 수 없어 raw SQL 마이그레이션으로 관리한다.

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// 감사 로그 — 신뢰 경계 변이(역할변경·가입승인/거절·동아리승인/거절)를 추적.
// 행위자가 삭제돼도 보존(SetNull)하고, 표시명/역할은 시점 스냅샷으로 비정규화 저장.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorNickname String? // 행위자 표시명 스냅샷(행위자 삭제·개명돼도 보존)
  actorRole     String? // 행위 시점 역할 스냅샷
  action        String // role_change | membership_approve | membership_reject | club_approve | club_reject
  targetType    String // user | club
  targetId      String
  summary       String // 사람이 읽는 요약 (예: "member→staff", "가입 거절: 사유")
  ip            String?
  createdAt     DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// 유저 개인 알림 — 본인에게만 표시되는 인앱 알림(가입 승인/거절, 동아리 신청·수락,
// 새 모임 공지, 광장 댓글·공감 등 도메인 이벤트). Header 알림 벨이 최근 20건을 보여주고,
// 항목 클릭 시 link로 이동하며 해당 건을 isRead 처리한다.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // membership_approved|rejected, club_application_received|accepted|rejected, club_meeting_created, prayer_comment, prayer_intercession
  title     String
  body      String?
  link      String? // 클릭 시 이동할 앱 내부 경로(예: /clubs/<id>, /my/clubs, /prayer). 없으면 비이동.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// AI 대화 파싱 결과 리포트
model Report {
  id                  String               @id @default(cuid())
  userId              String
  catchphrase         String // "혼돈을 엮는 설계자"
  coreTraits          String // "구조집착, 통찰추적, 시스템사고"
  optimalEcosystem    String // 200% 발휘 환경 설명
  corePosition        String // 팀 내 압도적 역할 설명
  sourceAi            String // chatgpt | claude | gemini | other
  parsingModel        String // claude-haiku-4-5-20251001
  parsingVersion      String // v1.0
  shareSlug           String               @unique // 7자리 nanoid (공유 URL)
  isPublic            Boolean              @default(true) // 공개 여부 — false면 본인만 조회 가능
  viewCount           Int                  @default(0)
  createdAt           DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareEvents         ShareEvent[]
  clubRecommendations ClubRecommendation[]

  @@index([userId, createdAt])
  @@index([shareSlug])
}

// 코어 프롬프트 버전 관리 — 배포 없이 프롬프트 교체 가능
model PromptVersion {
  id        String   @id @default(cuid())
  version   String   @unique // v1.0, v1.1
  content   String
  isActive  Boolean  @default(false)
  notes     String? // 변경 이유 메모
  createdAt DateTime @default(now())
}

// AI 파싱 로그 — 원문 미저장, 글자 수·상태만
model ParsingLog {
  id           String   @id @default(cuid())
  userId       String?
  status       String // success | parse_failed | api_error | rate_limited
  sourceAi     String?
  inputLength  Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

// 공유 이벤트 — 바이럴 KPI 측정
model ShareEvent {
  id        String   @id @default(cuid())
  reportId  String
  platform  String // kakao | instagram | link_copy | twitter
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// 동아리 — 유저가 자유롭게 개설, 관리자 승인 후 노출
model Club {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String // 스터디 | 취미/여가 | 운동 | 봉사 | 창업/사이드프로젝트 | 문화/예술 | 친목
  tags        String // AI 매칭용 키워드 (쉼표 구분)
  ownerUserId String
  maxMembers  Int? // null이면 인원 제한 없음
  isApproved  Boolean  @default(false) // 관리자 승인 필요 — 승인 전 비노출
  isActive    Boolean  @default(true)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  // 청년부 전체 행사용 시스템 동아리(운영진 생성, 최대 1개 운용 전제) — 일반 동아리 목록에서
  // 숨기고 승인 멤버 전원을 자동 멤버로 취급한다. 기존 모임/RSVP/리마인더 기능을 그대로 재사용.
  isSystem    Boolean  @default(false)

  owner           User                 @relation("OwnedClubs", fields: [ownerUserId], references: [id], onDelete: Cascade)
  applications    ClubApplication[]
  recommendations ClubRecommendation[]
  images          ClubImage[]
  prayers         Prayer[]
  meetings        ClubMeeting[]

  @@index([category, isApproved, isActive])
  @@index([ownerUserId])
}

// 동아리 모임 공지 — 개설자가 등록, 멤버(개설자+가입 멤버)에게만 공개
model ClubMeeting {
  id             String    @id @default(cuid())
  clubId         String
  title          String    @default("정기 모임")
  meetsAt        DateTime // 모임 일시
  place          String // 장소
  items          String? // 준비물
  fee            String? // 회비 (예: "5,000원", "없음")
  note           String? // 일정·세부 안내
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // 24h 전 리마인더 발송 시점 — cron이 중복 발송을 막는 플래그(null이면 미발송).
  reminderSentAt DateTime?

  club    Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  reviews ClubMeetingReview[]
  images  ClubMeetingImage[]
  rsvps   ClubMeetingRsvp[]

  @@index([clubId, meetsAt])
  @@index([meetsAt, reminderSentAt])
}

// 모임 참석 표시(RSVP) — 멤버가 going(가요)/maybe(아마도)로 토글. 한 모임당 1행.
model ClubMeetingRsvp {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  status    String   @default("going") // going | maybe
  createdAt DateTime @default(now())

  meeting ClubMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
}

// 모임 후기 — 멤버 누구나 댓글 형식으로 작성. 작성자·개설자가 삭제 가능.
model ClubMeetingReview {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // 후기 수정 시 갱신 — createdAt과 다르면 "수정됨" 표시

  meeting ClubMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

// 모임 갤러리 사진 — 멤버 누구나 업로드. 업로더·개설자가 삭제 가능. 업로더 삭제돼도 사진 보존(SetNull).
model ClubMeetingImage {
  id        String   @id @default(cuid())
  meetingId String
  url       String
  caption   String   @default("")
  order     Int      @default(0)
  userId    String?
  createdAt DateTime @default(now())

  meeting  ClubMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploader User?       @relation("MeetingImageUploader", fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId, order])
}

// 광장(커뮤니티) 글 — 레거시 명칭 Prayer를 카테고리로 일반화.
// category로 일상 / 기도해주세요 / 동아리광고를 구분한다.
// 기도해주세요만 응답됨(isAnswered)·간증을 쓰고, 반응(intercessions)은 카테고리에 따라
// "기도할게요"(기도) / "공감"(일상·광고)으로 라벨만 달리 보여준다.
model Prayer {
  id           String    @id @default(cuid())
  userId       String
  category     String    @default("기도해주세요") // 일상 | 기도해주세요 | 동아리광고
  content      String
  scope        String    @default("ALL") // 레거시(집단 구분 폐기) — 항상 ALL
  clubId       String? // 레거시 — 동아리 기도 코너용(현재 미사용)
  isAnonymous  Boolean   @default(false) // 익명으로 올리기 (민감한 기도제목 보호)
  isAnswered   Boolean   @default(false) // 기도해주세요 전용
  answeredNote String? // 응답 간증 한 줄 (선택)
  answeredAt   DateTime?
  // 시스템이 자동 생성한 카드 구분(null=일반 글) — "welcome"(새가족 환영 카드) · "birthday"(생일 축하).
  // 작성자를 당사자 본인으로 두어 기존 댓글/공감 알림 파이프라인을 그대로 재사용한다.
  systemType   String?
  // 이번 주 아이스브레이커 질문에 대한 답변 글이면 연결(선택) — 질문 카드에서 답변 모아보기용.
  promptId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt // 글 수정 시 갱신 — createdAt과 다르면 "수정됨" 표시

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  club          Club?                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  prompt        IcebreakerPrompt?    @relation(fields: [promptId], references: [id], onDelete: SetNull)
  intercessions PrayerIntercession[]
  images        PrayerImage[]
  comments      PrayerComment[]

  @@index([category, isAnswered, createdAt])
  @@index([userId])
  @@index([promptId])
  @@index([clubId])
}

// "기도했어요"/"공감" — 한 사람이 한 글에 한 번만 (카테고리 무관 단일 반응)
model PrayerIntercession {
  id        String   @id @default(cuid())
  prayerId  String
  userId    String
  createdAt DateTime @default(now())

  prayer Prayer @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([prayerId, userId])
  @@index([prayerId])
}

// 광장 글 첨부 이미지 — 글당 최대 3장(서버 검증). 클라에서 압축 후 plaza-images 버킷 업로드.
model PrayerImage {
  id        String   @id @default(cuid())
  prayerId  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  prayer Prayer @relation(fields: [prayerId], references: [id], onDelete: Cascade)

  @@index([prayerId, order])
}

// 광장 글 댓글 — 승인 멤버만 작성. 작성자·글쓴이·운영진+가 삭제 가능.
model PrayerComment {
  id        String   @id @default(cuid())
  prayerId  String
  userId    String
  parentId  String? // 대댓글 — 단일 깊이만 허용(부모가 이미 답글이면 거부, API에서 검증)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // 댓글 수정 시 갱신 — createdAt과 다르면 "수정됨" 표시

  prayer  Prayer          @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PrayerComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PrayerComment[] @relation("CommentReplies")
  likes   PrayerCommentLike[]

  @@index([prayerId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// 광장 댓글 좋아요 — 댓글당 유저 1회(토글). 글 공감(PrayerIntercession)의 댓글판.
// 행의 존재 자체가 "좋아요 눌림"이라 취소는 삭제다(토글 처닝은 API에서 rate limit).
model PrayerCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment PrayerComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 같은 댓글에 두 번 눌러도 행이 하나뿐이도록 — 동시 요청 경합의 최종 방어선.
  @@unique([commentId, userId])
  @@index([commentId])
}

// 동아리 카드뉴스 이미지 — 개설 시 등록, 순서 보존
model ClubImage {
  id        String   @id @default(cuid())
  clubId    String
  url       String
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, order])
}

// 동아리 가입 신청 — 앱 내 신청
model ClubApplication {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  message   String? // 신청 메시지 (선택)
  status    String   @default("pending") // pending | accepted | rejected | left(자진 탈퇴) | removed(강퇴)
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId]) // 중복 신청 방지
  @@index([userId, status])
  @@index([clubId, status])
}

// 전체 공지 — 운영진+ 작성, 모든 방문자에게 공개(홈 배너 최신 1건 + /notices 목록)
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  isPublished Boolean  @default(true) // false면 비공개 초안 — 공개 표면에 노출 안 됨
  isPinned    Boolean  @default(false) // 상단 고정 — 배너·목록에서 우선 노출
  authorId    String? // 작성자 삭제돼도 공지는 보존(SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation("AuthoredAnnouncements", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, isPinned, createdAt])
}

// AI 동아리 추천 결과 — 리포트 페르소나 기반
model ClubRecommendation {
  id        String   @id @default(cuid())
  userId    String
  reportId  String
  clubId    String
  score     Float // 매칭 점수 0~100
  reason    String // AI가 생성한 추천 이유
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([userId, reportId])
  @@index([clubId])
}

// 주간 운영 지표 스냅샷 — "새가족 정착" 개선이 실제 효과가 있는지 추세로 검증하기 위한
// 베이스라인. 매주 월요일 cron이 지난 주 값을 계산해 1행씩 적재(모두 기존 테이블에서 파생 —
// 별도 이벤트 로그 없음). weekOf는 그 주의 월요일 날짜(자정, UTC)로 정규화해 유니크.
model MetricSnapshot {
  id                       String   @id @default(cuid())
  weekOf                   DateTime @unique
  newcomer90dRetention     Float // 승인 90일 경과 멤버 중 최근 30일 내 활동 있는 비율(0~1)
  crossCellInteractionRate Float // 댓글·공감 중 작성자·글쓴이 dreamGroup이 다른 비율(0~1)
  clubJoinRate             Float // 승인 멤버 중 accepted 동아리 1개 이상 비율(0~1)
  activeMemberCount        Int // 그 주 활동(글·댓글·공감·RSVP)이 있었던 승인 멤버 수
  createdAt                DateTime @default(now())
}

// 짝꿍 매칭 — 멤버끼리 프로필에서 직접 신청/수락하는 1:1 관계.
// 연애 앱화 방지를 위해 같은 성별끼리만 신청 가능하고, 꿈터 경계는 넘어도 된다(공동체 전체 교류가 앱의 취지).
// 한 사람당 활성(active) 짝꿍은 최대 1명 — API 트랜잭션에서 강제한다(대칭 유니크는 DB로 표현 불가).
// status: pending(수락 대기) | active(성사) | declined(거절) | ended(해제/취소). 채팅 등 인앱 대화는 만들지 않는다.
// 짝꿍(BuddyMatch) 기능은 v2에서 제거됐다. DB 테이블 "BuddyMatch"는 원본 앱과 DB를 공유하므로
// 남겨두며(이 스키마에서만 빠짐), `prisma db push`를 돌리면 Prisma가 그 테이블을 지우려 하니 주의.

// 주간 아이스브레이커 질문 — 운영진이 /manage에서 등록하거나, 없으면 cron이 프리셋 풀에서
// 자동 선택한다. 광장 상단에 고정 카드로 노출되고, "답변하기"로 작성한 일상 글이 Prayer.promptId로 연결된다.
model IcebreakerPrompt {
  id          String   @id @default(cuid())
  weekOf      DateTime @unique
  question    String
  createdById String? // 운영진이 직접 등록했으면 그 사람, cron 자동 선택이면 null
  createdAt   DateTime @default(now())

  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  answers   Prayer[]
}

// 월간 리캡 — 매달 1일(KST) cron이 지난 한 달치를 계산해 1행 적재(전부 기존 테이블에서 파생).
// 광장 상단 배너 → 스크롤 슬라이드 뷰어로 노출. monthOf는 그 달 1일(자정, UTC)로 정규화해 유니크.
model MonthlyRecap {
  id                  String   @id @default(cuid())
  monthOf             DateTime @unique
  postCount           Int // 그 달 광장 글 수(시스템 카드 제외)
  reactionCount       Int // 그 달 공감(PrayerIntercession) 수
  commentCount        Int // 그 달 댓글 수(대댓글 포함)
  newcomerCount       Int // 그 달 승인된 새가족 수
  birthdayCount       Int // 그 달 생일 축하 카드 수
  answeredPrayerCount Int // 그 달 응답 표시된 기도 수
  topPostId           String? // 그 달 가장 많은 공감을 받은 글(있으면)
  topPostSnippet      String?
  topPostAuthorName   String?
  topPostReactionCount Int?
  createdAt           DateTime @default(now())
}

// 고객센터 문의 — 광장과 별개로 운영진에게 전달되는 1:1 문의/건의함.
// isSecret=false(기본)면 승인 멤버 전체가 볼 수 있는 공개 게시판(광장과 동일한 노출 범위),
// isSecret=true면 작성자 본인 + 운영진만 볼 수 있다. 두 옵션 다 미승인(pending 등) 유저도
// 로그인만 하면 문의를 남기고 자기 글은 볼 수 있다(가입 절차 자체에 대한 문의도 여기로 온다) —
// 다만 미승인 유저는 다른 사람의 공개 글까지는 못 본다(API에서 강제).
// isAnonymous는 광장 '기도해주세요'와 동일한 의미로, 운영진에게도 신원을 가린다(진짜 익명).
// 댓글 개념이 없다 — 답글(SupportReply)은 오직 운영진(staff+)만 작성 가능.
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  content     String
  isAnonymous Boolean  @default(false)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportReply[]

  @@index([isSecret, createdAt])
  @@index([userId])
}

// 고객센터 답글 — 운영진(staff+)만 작성. 작성한 스태프 본인·다른 운영진에게는 실명이 보이지만,
// 문의를 남긴 당사자에게는 항상 "운영진"으로만 표시된다(개별 운영진이 답변 때문에 특정
// 민원의 표적이 되지 않도록 — prayers/route.ts의 "익명 글은 관리자 신원도 숨긴다"와 같은 원칙을
// 여기서는 답변자 쪽에 선제적으로 적용). staffId는 표시용이 아니라 내부 식별용이라 탈퇴해도
// 보존할 필요가 없어 SetNull.
model SupportReply {
  id        String   @id @default(cuid())
  ticketId  String
  staffId   String?
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff  User?          @relation("SupportStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
